{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "COMP_CRM_API_URL": "@comp_crm_api_url",
    "COMP_CRM_API_KEY": "@comp_crm_api_key"
  }
}